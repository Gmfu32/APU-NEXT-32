DATABASE_URL=sqlite:///./apu_next.db
AUTH_SECRET=replace-with-a-long-random-secret-before-deployment
CAREER_STAFF_INVITE_CODE=choose-a-private-career-centre-invite-code
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# For Supabase PostgreSQL, replace DATABASE_URL with the connection string from
# Supabase Project Settings > Database. Keep this file server-side; never use VITE_*.

# Optional Gmail SMTP delivery (create a Google App Password; never use your Gmail login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-apu-next-sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-apu-next-sender@gmail.com
CAREER_CENTER_EMAIL=
APP_BASE_URL=http://localhost:3000
