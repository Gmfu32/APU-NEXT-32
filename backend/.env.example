DATABASE_URL=sqlite:///./apu_next.db
AUTH_SECRET=
CAREER_STAFF_INVITE_CODE=
UPLOAD_DIR=./uploads
CAREERJET_API_KEY=
# Set this to a website/page you own that is registered with Careerjet.
# This is not the Careerjet account or publisher-management page.
# For local testing, CAREERJET_USER_IP can be your public IP; public deployments
# should use the requester's client IP forwarded by a trusted reverse proxy.
CAREERJET_PUBLISHER_URL=
CAREERJET_USER_IP=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# For Supabase PostgreSQL, replace DATABASE_URL with the connection string from
# Supabase Project Settings > Database. Keep this file server-side; never use VITE_*.

# Optional Gmail SMTP delivery (create a Google App Password; never use your Gmail login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@example.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-sender@example.com
CAREER_CENTER_EMAIL=career-centre@example.com
APP_BASE_URL=http://localhost:3000
EVENT_DETAILS=18 November 2026, 8:00 AM–3:30 PM, Auditorium 5, Level 3. Bring the QR confirmation to the entrance.
MOCK_INTERVIEW_SCHEDULING_URL=https://docs.google.com/forms/d/e/1FAIpQLScPAPORcTC9u0JMkn5DEf8DYUvGA2axDPrCAzrZSTilLJDfXA/viewform
CV_REVIEW_MESSAGE=Your CV review is complete.\nYour experience is clearly presented.\nConsider adding more measurable achievements.\nPlease review your profile for further career guidance.
